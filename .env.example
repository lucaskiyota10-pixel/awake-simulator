# Integração futura com o e-commerce (todas opcionais).
# URL da loja: ativa o link externo do botão "Ver produto no catálogo".
# VITE_COMMERCE_STORE_URL=https://loja.awakehomedecor.com.br
# Caminho da página do produto ({sku} ou {id}).
# VITE_COMMERCE_PRODUCT_PATH=/produto/{sku}
# API de catálogo (GET /products -> CommerceProduct[]): substitui o catálogo local.
# VITE_CATALOG_API_URL=https://api.exemplo.com/catalogo
